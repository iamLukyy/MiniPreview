<Window x:Class="MiniPreview.UI.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniPreview"
        Width="320" Height="240"
        MinWidth="220" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- Toolbar button: flat, white glyph, hover highlight -->
        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="ToolTipService.ShowDuration" Value="6000"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TbCloseBtn" TargetType="Button" BasedOn="{StaticResource TbBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#80FFFFFF" BorderThickness="1" Background="Black" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top toolbar -->
            <Border Grid.Row="0" Background="#C0202428" MouseLeftButtonDown="OnTopBarDrag" CornerRadius="3,3,0,0">
                <DockPanel LastChildFill="True">
                    <Image x:Name="AppIcon" DockPanel.Dock="Left" Width="16" Height="16" Margin="6,0,2,0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,2,4,2">
                        <!-- Wide dropdown-looking source picker so it reads as interactive -->
                        <Button x:Name="PickBtn" Style="{StaticResource TbBtn}" Width="Auto" MinWidth="44" Padding="6,0" ToolTip="Vyber okno (Ctrl+Alt+L)" Click="OnPickBtnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"  VerticalAlignment="Center" Margin="2,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MinTargetBtn" Style="{StaticResource TbBtn}"     Content="&#xE921;" ToolTip="Minimalizuj/obnov target (Ctrl+Alt+H)" Click="OnMinTargetClick"/>
                        <Button x:Name="PauseBtn"    Style="{StaticResource TbBtn}"      Content="&#xE769;" ToolTip="Pauza náhledu (Ctrl+Alt+P)" Click="OnPauseClick"/>
                        <Button x:Name="MuteBtn"     Style="{StaticResource TbBtn}"      Content="&#xE767;" ToolTip="Mute target (Ctrl+Alt+M)" Click="OnMuteClick"/>
                        <Button x:Name="FpsBtn"      Style="{StaticResource TbBtn}"      Content="5"        ToolTip="FPS náhledu" FontFamily="Segoe UI" FontSize="11" Click="OnFpsBtnClick"/>
                        <Button x:Name="SettingsBtn" Style="{StaticResource TbBtn}"      Content="&#xE713;" ToolTip="Nastavení" Click="OnSettingsClick"/>
                        <Button x:Name="CloseBtn"    Style="{StaticResource TbCloseBtn}" Content="&#xE8BB;" ToolTip="Konec" Click="OnExitClick"/>
                    </StackPanel>
                    <TextBlock x:Name="TargetLabel" Foreground="#D0FFFFFF" FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="4,0,8,0" Text="MiniPreview" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Preview image -->
            <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform"/>

            <!-- Mute indicator overlay (top-right corner of preview) -->
            <Border x:Name="MuteOverlay" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0" Padding="6,4"
                    Background="#C0C82020" CornerRadius="14">
                <TextBlock Foreground="White" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text=""/>
            </Border>

            <!-- Pause indicator overlay (top-left corner of preview) -->
            <Border x:Name="PauseOverlay" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8,8,0,0" Padding="6,4"
                    Background="#C0202020" CornerRadius="14">
                <TextBlock Foreground="White" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text=""/>
            </Border>

            <!-- Status overlay (only over preview area) -->
            <Grid x:Name="StatusOverlay" Grid.Row="1" Visibility="Collapsed" Background="#A0000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <TextBlock x:Name="StatusText" Foreground="White" FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button x:Name="StatusPickBtn" Visibility="Collapsed" Margin="0,14,0,0" HorizontalAlignment="Center"
                            Padding="16,7" Cursor="Hand" FontFamily="Segoe UI" FontSize="12" Click="OnPickBtnClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#3296F0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#4EA8F5"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1F7AD4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
