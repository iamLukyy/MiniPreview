<Window x:Class="MiniPreview.UI.FeatureCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="RecheckBtn" Width="100" Margin="4" Click="OnRecheck"/>
            <Button x:Name="TryAnywayBtn" Width="120" Margin="4" Click="OnTryAnyway"/>
            <Button x:Name="ExitBtn" Width="100" Margin="4" Click="OnExit" IsCancel="True"/>
        </StackPanel>
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProbesList"/>
        </ScrollViewer>
    </DockPanel>
</Window>
