<Window x:Class="MiniPreview.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkBtn" Width="80" Margin="4" IsDefault="True" Click="OnOk"/>
            <Button x:Name="CancelBtn" Width="80" Margin="4" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <GroupBox x:Name="LanguageGroup" Margin="0,0,0,12" Padding="8">
                <StackPanel>
                    <ComboBox x:Name="LanguageBox" DisplayMemberPath="DisplayName" SelectedValuePath="Code" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LanguageHint" TextWrapping="Wrap" FontSize="11" Foreground="Gray"/>
                </StackPanel>
            </GroupBox>
            <GroupBox x:Name="HotkeysGroup" Margin="0,0,0,12" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="PauseLabel" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="PauseHotkey" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="MuteLabel" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="MuteHotkey" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" x:Name="PickerLabel" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PickerHotkey" Margin="0,4"/>
                </Grid>
            </GroupBox>
            <TextBlock x:Name="HotkeyHint" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,12"/>
            <CheckBox x:Name="AutostartBox" Margin="0,8"/>
            <CheckBox x:Name="AlwaysOnTopBox" Margin="0,4"/>
        </StackPanel>
    </DockPanel>
</Window>
