<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MiniPreview</RootNamespace>
    <AssemblyName>MiniPreview</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\MiniPreview.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Disable CsWinRT source generation; we only need the runtime embedded types (IObjectReference, MarshalInterface, etc.) -->
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
    <StartupObject>MiniPreview.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\MiniPreview.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.DXGI" Version="3.5.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
</Project>
